// [pro-grade]
priority "grant";

// ============================================
// GLOBAL DENIES - Apply to ALL code
// ============================================
deny {
  // Block command execution
  permission java.io.FilePermission "<<ALL FILES>>", "execute";
  permission java.io.FilePermission "/-", "execute";
  permission java.io.FilePermission "*", "execute";
  permission java.io.FilePermission "${catalina.home}/webapps/bonita/WEB-INF/classes/org/codehaus/groovy/runtime/ProcessGroovyMethods$ProcessRunner.class", "read";

  // Block thread stopping only (dangerous, deprecated)
  permission java.lang.RuntimePermission "stopThread";

  // Block security manager bypass
  permission java.lang.RuntimePermission "setSecurityManager";
  // Block dangerous security permissions (allow get/setProperty.* needed by Tomcat)
  permission java.security.SecurityPermission "setPolicy";
  permission java.security.SecurityPermission "createPolicy.*";
}

// ============================================
// GLOBAL GRANTS - Minimal required permissions
// ============================================
grant {
  permission java.io.FilePermission "${java.io.tmpdir}/-", "read,write";
  permission java.lang.RuntimePermission "getenv.SOURCE_DATE_EPOCH";
}

// ============================================
// TEMP DIRECTORY CODE (compiled Groovy scripts)
// ============================================
grant codeBase "file:${java.io.tmpdir}/-" {
  permission java.io.FilePermission "/opt/bonita_run/logs/-", "read,write";
}

deny codeBase "file:${java.io.tmpdir}/-" {
  permission java.lang.RuntimePermission "getenv.*";
  permission java.lang.RuntimePermission "exitVM.*";
  permission java.io.FilePermission "/-", "write";
  permission java.io.FilePermission "${catalina.home}/conf/-", "read";
  permission java.io.FilePermission "${catalina.home}/../setup/-", "read";
  permission java.util.PropertyPermission "*", "write";

  // Block reading sensitive system files
  permission java.io.FilePermission "/etc/shadow", "read";
  permission java.io.FilePermission "/etc/passwd", "read";
  permission java.io.FilePermission "/etc/environment", "read";
  permission java.io.FilePermission "/root/-", "read";

  // Block reading cloud/container metadata
  permission java.io.FilePermission "/var/run/secrets/-", "read";
  permission java.io.FilePermission "/run/secrets/-", "read";
}

// ============================================
// GROOVY SHELL CODE (dynamic eval)
// ============================================
grant codeBase "file:/groovy/shell" {
  permission java.io.FilePermission "/opt/bonita_run/logs/-", "read,write";
}

deny codeBase "file:/groovy/shell" {
  permission java.lang.RuntimePermission "getenv.*";
  permission java.lang.RuntimePermission "exitVM.*";
  permission java.io.FilePermission "/-", "write";
  permission java.io.FilePermission "${catalina.home}/conf/-", "read";
  permission java.io.FilePermission "${catalina.home}/../setup/-", "read";
  permission java.util.PropertyPermission "*", "write";

  // Block reading sensitive system files
  permission java.io.FilePermission "/etc/shadow", "read";
  permission java.io.FilePermission "/etc/passwd", "read";
  permission java.io.FilePermission "/etc/environment", "read";
  permission java.io.FilePermission "/root/-", "read";

  // Block reading cloud/container metadata
  permission java.io.FilePermission "/var/run/secrets/-", "read";
  permission java.io.FilePermission "/run/secrets/-", "read";
}
